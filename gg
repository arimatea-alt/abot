--// ---------------- Hotkeys ----------------
local UserInputService = game:GetService("UserInputService")

local hotkeyDefaults = {
    aim_key = Enum.KeyCode.LeftAlt,
    aim_togglebind = Enum.KeyCode.Insert,
    aim_nexttarget = Enum.KeyCode.RightBracket,
    aim_prevtarget = Enum.KeyCode.LeftBracket,
}

local function boundKey(flag)
    local ok, v = pcall(function() return window:Get(flag) end)
    if ok and typeof(v) == "EnumItem" and v.EnumType == Enum.KeyCode then
        return v
    end
    return hotkeyDefaults[flag]
end

local hotkeyConns = {}

table.insert(hotkeyConns, UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    -- Ignore keys while the player is typing (chat, search boxes).
    if UserInputService:GetFocusedTextBox() then return end

    local k = input.KeyCode
    if k == boundKey("aim_key") then
        aimHeld = true
    elseif k == boundKey("aim_togglebind") then
        toggleAimbot()
    elseif k == boundKey("aim_nexttarget") then
        cycleTarget(1)
    elseif k == boundKey("aim_prevtarget") then
        cycleTarget(-1)
    end
end))

table.insert(hotkeyConns, UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if input.KeyCode == boundKey("aim_key") then
        aimHeld = false
    end
end))

table.insert(hotkeyConns, UserInputService.WindowFocusReleased:Connect(function()
    -- Releasing the window mid-hold would otherwise leave the aim key stuck down.
    aimHeld = false
end))

